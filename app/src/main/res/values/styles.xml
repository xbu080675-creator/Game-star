<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EsportsCenter" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:windowBackground">#02070B</item>
        <item name="android:navigationBarColor">#02070B</item>
        <item name="android:statusBarColor">#02070B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
      Launcher/starting-window theme. On Android 8-11 this preview is already the first
      frame of Game Star Box instead of a vendor/default light window. Android 12+
      overrides the same style name in values-v31 with the platform SplashScreen attrs.
    -->
    <style name="Theme.EsportsCenter.Starting" parent="Theme.EsportsCenter">
        <item name="android:windowBackground">@drawable/gsb_boot_preview</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
